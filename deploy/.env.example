# Скопируйте в .env в этой же папке deploy/ (файл .env не коммитим).
# Docker Compose подставляет переменные отсюда при `docker compose up`.

WEB_PORT=8090
MYSQL_PORT=3307

# Мини-CRM меню (сервис menu-crm, порт MENU_CRM_PORT)
MENU_CRM_PORT=3105
MENU_CRM_ADMIN_PASSWORD=change-me-strong
MENU_CRM_COOKIE_SECRET=random-long-cookie-secret
MENU_CRM_PUBLIC_API_KEY=random-api-key-for-site

IIKO_API_BASE=https://api-ru.iiko.services
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=
